{
  "name": "envelope-studio",
  "version": "4.1.0",
  "author": "Zody King",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "desktop": "electron electron/dev.cjs",
    "desktop:build": "nuxt generate && electron-builder --win portable"
  },
  "dependencies": {
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extension-text-style": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@tiptap/vue-3": "3.32.2",
    "nuxt": "4.6.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vue-tsc": "^3.3.14"
  },
  "build": {
    "appId": "com.envelopestudio.app",
    "productName": "Envelope Studio",
    "executableName": "E-Studio",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      ".output/public/**/*",
      "!**/node_modules/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "E-Studio.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
